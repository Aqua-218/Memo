# ===========================================
# Personal Reminder App - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# -------------------------------------------
# Gemini API Configuration
# -------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for text generation
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Gemini model for embeddings
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -------------------------------------------
# API Settings
# -------------------------------------------
# Request timeout in seconds
API_TIMEOUT_SECONDS=30

# Maximum retries for failed requests
API_MAX_RETRIES=3

# -------------------------------------------
# Similarity Detection Settings
# -------------------------------------------
# Threshold for duplicate detection (0.0 - 1.0)
# Higher = stricter matching
SIMILARITY_THRESHOLD=0.85

# Maximum number of similar items to return
SIMILARITY_MAX_RESULTS=5

# -------------------------------------------
# Debug Settings
# -------------------------------------------
# Enable debug mode (true/false)
DEBUG_MODE=false

# Enable verbose logging (true/false)
VERBOSE_LOGGING=false
